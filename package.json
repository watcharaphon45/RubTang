{
  "name": "rubtang",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @rubtang/api\" \"npm run dev -w @rubtang/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @rubtang/api",
    "test:integration": "npm run test:integration -w @rubtang/api",
    "db:local": "npm run db:local -w @rubtang/api",
    "db:generate": "npm run db:generate -w @rubtang/api",
    "db:migrate": "npm run db:migrate -w @rubtang/api"
  },
  "devDependencies": { "concurrently": "^9.2.1" },
  "overrides": { "multer": "^2.3.0", "deepmerge-ts": "^8.0.0" }
}
