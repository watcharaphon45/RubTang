generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum MovementType {
  RECEIVE
  ADJUSTMENT
  SALE
  VOID_SALE
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
}

enum TransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  VOIDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PointTransactionType {
  EARN
  REDEEM
  REVERT
  ADJUST
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum StockTakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaxInvoiceType {
  FULL
  ABBREVIATED
}

enum TaxInvoiceStatus {
  ISSUED
  CANCELLED
}

enum RefundMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  ORIGINAL_PAYMENT
}

enum ReturnItemCondition {
  RESTOCKABLE
  DAMAGED
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime     @default(now())
  branches  Branch[]
  members   Membership[]
  products  Product[]
  audits    AuditLog[]
  customers Customer[]
  shifts    Shift[]
  transfers StockTransfer[]
  promotions Promotion[]
  suppliers  Supplier[]
  purchaseOrders PurchaseOrder[]
  pointLedgers   PointLedger[]
  loyaltyRewards LoyaltyReward[]
  stockTakes     StockTake[]
  taxInvoices    TaxInvoice[]
  lineOaSettings LineOaSettings?
  lineReceiptLogs LineReceiptLog[]
  saleReturns     SaleReturn[]
}


model Branch {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  name        String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  assignments BranchAssignment[]
  inventory   InventoryBalance[]
  movements   StockMovement[]
  sales       Sale[]
  shifts      Shift[]
  transfersOrigin      StockTransfer[] @relation("TransferOrigin")
  transfersDestination StockTransfer[] @relation("TransferDestination")
  promotions           Promotion[]
  purchaseOrders       PurchaseOrder[]
  stockTakes           StockTake[]
  saleReturns          SaleReturn[]
  companyName          String?
  taxId                String?
  taxAddress           String?
  branchNumber         String?             @default("00000")
  isHeadOffice         Boolean             @default(true)
  phone                String?
  receiptHeader        String?
  receiptFooter        String?
  promptPayType        String?             @default("MOBILE")
  promptPayAccount     String?
  promptPayName        String?
  promptPayBank        String?
  taxInvoices          TaxInvoice[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
}


model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  displayName  String
  passwordHash String
  memberships  Membership[]
  audits       AuditLog[]
}

model Membership {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  userId      String             @db.Uuid
  role        Role               @default(CASHIER)
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  assignments BranchAssignment[]
  sessions    Session[]
  movements   StockMovement[]
  sales       Sale[]             @relation("SaleCashier")
  voidedSales Sale[]             @relation("SaleVoidedBy")
  shifts      Shift[]
  createdTransfers  StockTransfer[] @relation("TransferCreatedBy")
  receivedTransfers StockTransfer[] @relation("TransferReceivedBy")
  createdPurchaseOrders  PurchaseOrder[] @relation("POCreatedBy")
  receivedPurchaseOrders PurchaseOrder[] @relation("POReceivedBy")
  pointLedgers           PointLedger[]   @relation("PointLedgerActor")
  createdStockTakes      StockTake[]     @relation("StockTakeCreatedBy")
  approvedStockTakes     StockTake[]     @relation("StockTakeApprovedBy")
  issuedTaxInvoices      TaxInvoice[]    @relation("TaxInvoiceIssuedBy")
  processedReturns       SaleReturn[]    @relation("ReturnProcessedBy")
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
}


model BranchAssignment {
  tenantId     String     @db.Uuid
  membershipId String     @db.Uuid
  branchId     String     @db.Uuid
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id])
  branch       Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id])
  @@id([tenantId, membershipId, branchId])
}

model Session {
  tokenHash    String     @id
  membershipId String     @db.Uuid
  expiresAt    DateTime
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model Product {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  name      String
  sku       String
  barcode   String?
  price     Decimal            @db.Decimal(12, 2)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  inventory InventoryBalance[]
  movements StockMovement[]
  saleItems SaleItem[]
  transferItems StockTransferItem[]
  poItems       PurchaseOrderItem[]
  stockTakeItems StockTakeItem[]
  saleReturnItems SaleReturnItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, createdAt])
}

model InventoryBalance {
  tenantId String  @db.Uuid
  branchId String  @db.Uuid
  productId String @db.Uuid
  quantity Decimal @default(0) @db.Decimal(14, 3)
  branch   Branch  @relation(fields: [tenantId, branchId], references: [tenantId, id])
  product  Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  @@id([tenantId, branchId, productId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  entityId    String
  newValue    Json
  oldValue    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  actor       User     @relation(fields: [actorUserId], references: [id])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, actorUserId])
}

model StockMovement {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  branchId          String       @db.Uuid
  productId         String       @db.Uuid
  actorMembershipId String       @db.Uuid
  requestId         String       @db.Uuid
  type              MovementType
  quantity          Decimal      @db.Decimal(14, 3)
  balanceBefore     Decimal      @db.Decimal(14, 3)
  balanceAfter      Decimal      @db.Decimal(14, 3)
  note              String
  createdAt         DateTime     @default(now())
  branch            Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id])
  product           Product      @relation(fields: [tenantId, productId], references: [tenantId, id])
  actor             Membership   @relation(fields: [tenantId, actorMembershipId], references: [tenantId, id])
  @@unique([tenantId, requestId])
  @@index([tenantId, branchId, createdAt, id])
  @@index([tenantId, branchId, productId, createdAt])
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String        @db.Uuid
  cashierId      String        @db.Uuid
  customerId     String?       @db.Uuid
  shiftId        String?       @db.Uuid
  receiptNumber  String
  status         SaleStatus    @default(COMPLETED)
  voidedAt       DateTime?
  voidedById     String?       @db.Uuid
  voidReason     String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  pointsEarned   Int           @default(0)
  pointsRedeemed Int           @default(0)
  pointsDiscount Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  paymentDetail  Json?
  createdAt      DateTime      @default(now())
  branch         Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id])
  cashier        Membership    @relation("SaleCashier", fields: [tenantId, cashierId], references: [tenantId, id])
  voidedBy       Membership?   @relation("SaleVoidedBy", fields: [tenantId, voidedById], references: [tenantId, id])
  customer       Customer?     @relation(fields: [tenantId, customerId], references: [tenantId, id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  items          SaleItem[]
  pointLedgers   PointLedger[]
  taxInvoices    TaxInvoice[]
  lineReceiptLogs LineReceiptLog[]
  saleReturns    SaleReturn[]
  @@unique([tenantId, receiptNumber])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, shiftId])
}



model SaleItem {
  id               String           @id @default(uuid()) @db.Uuid
  saleId           String           @db.Uuid
  productId        String           @db.Uuid
  name             String
  sku              String
  price            Decimal          @db.Decimal(12, 2)
  quantity         Decimal          @db.Decimal(14, 3)
  returnedQuantity Decimal          @default(0) @db.Decimal(14, 3)
  subtotal         Decimal          @db.Decimal(12, 2)
  sale             Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])
  returnItems      SaleReturnItem[]
  @@index([saleId])
  @@index([productId])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  name           String
  phone          String
  points         Int            @default(0)
  lifetimePoints Int            @default(0)
  tier           MembershipTier @default(BRONZE)
  note           String?
  lineUserId     String?
  lineDisplayName String?
  linePictureUrl String?
  lineLinkedAt   DateTime?
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  sales          Sale[]
  pointLedgers   PointLedger[]
  lineReceiptLogs LineReceiptLog[]
  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@unique([tenantId, lineUserId])
  @@index([tenantId, name])
}

model Shift {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  branchId      String      @db.Uuid
  cashierId     String      @db.Uuid
  status        ShiftStatus @default(OPEN)
  startingCash  Decimal     @db.Decimal(12, 2)
  cashSales     Decimal     @default(0) @db.Decimal(12, 2)
  transferSales Decimal     @default(0) @db.Decimal(12, 2)
  expectedCash  Decimal     @default(0) @db.Decimal(12, 2)
  actualCash    Decimal?    @db.Decimal(12, 2)
  difference    Decimal?    @db.Decimal(12, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  openedNote    String?
  closedNote    String?
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  branch        Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id])
  cashier       Membership  @relation(fields: [tenantId, cashierId], references: [tenantId, id])
  sales         Sale[]

  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, openedAt])
}

model StockTransfer {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  transferNumber      String
  originBranchId      String              @db.Uuid
  destinationBranchId String              @db.Uuid
  createdById         String              @db.Uuid
  receivedById        String?             @db.Uuid
  status              TransferStatus      @default(IN_TRANSIT)
  notes               String?
  createdAt           DateTime            @default(now())
  receivedAt          DateTime?
  cancelledAt         DateTime?
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  originBranch        Branch              @relation("TransferOrigin", fields: [tenantId, originBranchId], references: [tenantId, id])
  destinationBranch   Branch              @relation("TransferDestination", fields: [tenantId, destinationBranchId], references: [tenantId, id])
  createdBy           Membership          @relation("TransferCreatedBy", fields: [tenantId, createdById], references: [tenantId, id])
  receivedBy          Membership?         @relation("TransferReceivedBy", fields: [tenantId, receivedById], references: [tenantId, id])
  items               StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, originBranchId, status])
  @@index([tenantId, destinationBranchId, status])
  @@index([tenantId, createdAt])
}

model StockTransferItem {
  id         String        @id @default(uuid()) @db.Uuid
  transferId String        @db.Uuid
  productId  String        @db.Uuid
  quantity   Decimal       @db.Decimal(14, 3)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
}

model Promotion {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  name          String
  code          String?
  discountType  DiscountType
  discountValue Decimal       @db.Decimal(12, 2)
  minSpend      Decimal       @default(0) @db.Decimal(12, 2)
  maxDiscount   Decimal?      @db.Decimal(12, 2)
  branchId      String?       @db.Uuid
  active        Boolean       @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  branch        Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([tenantId, branchId])
}

model Supplier {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  creditDays  Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, active])
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  poNumber     String
  supplierId   String              @db.Uuid
  branchId     String              @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  createdById  String              @db.Uuid
  receivedById String?             @db.Uuid
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)
  note         String?
  orderedAt    DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime            @default(now())

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  supplier     Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  branch       Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id])
  createdBy    Membership          @relation("POCreatedBy", fields: [tenantId, createdById], references: [tenantId, id])
  receivedBy   Membership?         @relation("POReceivedBy", fields: [tenantId, receivedById], references: [tenantId, id])
  items        PurchaseOrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, poNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, createdAt])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid()) @db.Uuid
  purchaseOrderId  String        @db.Uuid
  productId        String        @db.Uuid
  orderedQuantity  Decimal       @db.Decimal(14, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(14, 3)
  unitCost         Decimal       @db.Decimal(12, 2)
  totalCost        Decimal       @db.Decimal(12, 2)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model PointLedger {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  customerId        String               @db.Uuid
  saleId            String?              @db.Uuid
  actorMembershipId String?              @db.Uuid
  type              PointTransactionType
  amount            Int
  balanceAfter      Int
  reason            String
  createdAt         DateTime             @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  actor    Membership? @relation("PointLedgerActor", fields: [tenantId, actorMembershipId], references: [tenantId, id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, type])
}

model LoyaltyReward {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  title          String
  pointsCost     Int
  discountAmount Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
}

model StockTake {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  branchId     String          @db.Uuid
  takeNumber   String
  status       StockTakeStatus @default(IN_PROGRESS)
  createdById  String          @db.Uuid
  approvedById String?         @db.Uuid
  note         String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  branch     Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  createdBy  Membership      @relation("StockTakeCreatedBy", fields: [tenantId, createdById], references: [tenantId, id])
  approvedBy Membership?     @relation("StockTakeApprovedBy", fields: [tenantId, approvedById], references: [tenantId, id])
  items      StockTakeItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, takeNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, startedAt])
}

model StockTakeItem {
  id              String   @id @default(uuid()) @db.Uuid
  stockTakeId     String   @db.Uuid
  productId       String   @db.Uuid
  systemQuantity  Decimal  @db.Decimal(14, 3)
  countedQuantity Decimal  @db.Decimal(14, 3)
  variance        Decimal  @db.Decimal(14, 3)
  unitPrice       Decimal  @default(0) @db.Decimal(12, 2)
  varianceValue   Decimal  @default(0) @db.Decimal(12, 2)
  note            String?

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([stockTakeId])
  @@index([productId])
}

model TaxInvoice {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @db.Uuid
  branchId             String           @db.Uuid
  saleId               String           @db.Uuid
  invoiceNumber        String
  type                 TaxInvoiceType   @default(FULL)
  status               TaxInvoiceStatus @default(ISSUED)
  customerName         String
  customerTaxId        String?
  customerAddress      String?
  customerBranchNumber String?          @default("00000")
  customerIsHeadOffice Boolean          @default(true)
  customerPhone        String?
  subtotal             Decimal          @db.Decimal(12, 2)
  discount             Decimal          @default(0) @db.Decimal(12, 2)
  taxableAmount        Decimal          @db.Decimal(12, 2)
  vatRate              Decimal          @default(7.00) @db.Decimal(5, 2)
  vatAmount            Decimal          @db.Decimal(12, 2)
  total                Decimal          @db.Decimal(12, 2)
  bahtText             String
  issuedById           String           @db.Uuid
  issuedAt             DateTime         @default(now())
  note                 String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  branch   Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id])
  sale     Sale       @relation(fields: [saleId], references: [id])
  issuedBy Membership @relation("TaxInvoiceIssuedBy", fields: [tenantId, issuedById], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, branchId, issuedAt])
  @@index([tenantId, saleId])
}

enum LineReceiptStatus {
  SENT
  FAILED
  PENDING
}

model LineOaSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @db.Uuid
  accountName        String
  basicId            String?
  channelId          String?
  channelSecret      String?
  channelAccessToken String?
  autoSendReceipt    Boolean  @default(true)
  welcomeMessage     String?
  qrCodeUrl          String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
}

model LineReceiptLog {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  saleId        String            @db.Uuid
  customerId    String?           @db.Uuid
  lineUserId    String
  receiptNumber String
  status        LineReceiptStatus @default(SENT)
  flexPayload   Json
  errorMessage  String?
  sentAt        DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  sale          Sale              @relation(fields: [saleId], references: [id])
  customer      Customer?         @relation(fields: [customerId], references: [id])

  @@index([tenantId, sentAt])
  @@index([tenantId, saleId])
  @@index([tenantId, lineUserId])
}

model SaleReturn {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  branchId        String            @db.Uuid
  saleId          String            @db.Uuid
  returnNumber    String
  refundMethod    RefundMethod
  subtotalRefund  Decimal           @db.Decimal(12, 2)
  vatRefund       Decimal           @default(0) @db.Decimal(12, 2)
  totalRefund     Decimal           @db.Decimal(12, 2)
  pointsDeducted  Int               @default(0)
  reason          String
  processedById   String            @db.Uuid
  createdAt       DateTime          @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  branch          Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id])
  sale            Sale              @relation(fields: [saleId], references: [id])
  processedBy     Membership        @relation("ReturnProcessedBy", fields: [tenantId, processedById], references: [tenantId, id])
  items           SaleReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, saleId])
}

model SaleReturnItem {
  id              String              @id @default(uuid()) @db.Uuid
  saleReturnId    String              @db.Uuid
  saleItemId      String              @db.Uuid
  productId       String              @db.Uuid
  quantity        Decimal             @db.Decimal(14, 3)
  unitPrice       Decimal             @db.Decimal(12, 2)
  discount        Decimal             @default(0) @db.Decimal(12, 2)
  refundAmount    Decimal             @db.Decimal(12, 2)
  restock         Boolean             @default(true)
  condition       ReturnItemCondition @default(RESTOCKABLE)
  note            String?

  saleReturn      SaleReturn          @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem        SaleItem            @relation(fields: [saleItemId], references: [id])
  product         Product             @relation(fields: [productId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
}
